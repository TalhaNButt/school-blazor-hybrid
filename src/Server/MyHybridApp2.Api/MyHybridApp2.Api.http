@HostAddress = http://localhost:5206

GET {{HostAddress}}/health

###

GET {{HostAddress}}/api/posts
Accept: application/json

###

# @name createPost
POST {{HostAddress}}/api/posts
Content-Type: application/json

{
  "authorName": "Jane Smith",
  "contentText": "Hello from the API #dotnet",
  "mediaUrl": null,
  "mediaType": null
}

###

### Get comments for the created post
GET {{HostAddress}}/api/posts/{{createPost.response.body.$.id}}/comments
Accept: application/json

###

### Add a comment to the created post
# @name createComment
POST {{HostAddress}}/api/posts/{{createPost.response.body.$.id}}/comments
Content-Type: application/json

{
  "authorName": "Alex Johnson",
  "content": "This is a comment on the post."
}

###

### Get the created comment
GET {{HostAddress}}/api/posts/{{createPost.response.body.$.id}}/comments/{{createComment.response.body.$.id}}
Accept: application/json

###

### List calendar events
GET {{HostAddress}}/api/calendar-events
Accept: application/json

###

### Create a calendar event
# @name createCalendarEvent
POST {{HostAddress}}/api/calendar-events
Content-Type: application/json

{
  "title": "Science exam",
  "category": "Exam",
  "location": "Room 204",
  "description": "Review chapters 1-5",
  "startsAt": "2026-12-01T09:00:00+05:00",
  "endsAt": "2026-12-01T10:00:00+05:00",
  "reminderMinutesBefore": 15
}

###

### Get a calendar event
GET {{HostAddress}}/api/calendar-events/{{createCalendarEvent.response.body.$.id}}
Accept: application/json

###

### Update a calendar event
PUT {{HostAddress}}/api/calendar-events/{{createCalendarEvent.response.body.$.id}}
Content-Type: application/json

{
  "title": "Science exam - updated",
  "category": "Exam",
  "location": "Room 204",
  "description": "Review chapters 1-5",
  "startsAt": "2026-12-01T09:30:00+05:00",
  "endsAt": "2026-12-01T10:30:00+05:00",
  "reminderMinutesBefore": 30
}

###

### Delete a calendar event
DELETE {{HostAddress}}/api/calendar-events/{{createCalendarEvent.response.body.$.id}}
