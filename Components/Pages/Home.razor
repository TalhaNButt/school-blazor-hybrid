@* @page "/"
@inject NavigationManager Navigation

<!-- CardsPage.razor -->
<div class="cards-container">
    @foreach (var card in Cards)
    {
        <div class="card" @onclick="NavigateToUserDetailComponent">
            <img src="@card.ImageUrl" alt="@card.Title" class="card-image" />
            <div class="card-content">
                <h3>@card.Title</h3>
                <p>@card.Description</p>
            </div>
        </div>
    }
</div>

@code {
    private void NavigateToUserDetailComponent() => Navigation.NavigateTo("user-detail");

    private List<CardModel> Cards = new()
    {
        new CardModel { Title = "Abdul Rafay Butt", Description = "Tiny Tots", ImageUrl = "images/dotnet_bot.svg" },
        new CardModel { Title = "Abdul Ahad Butt", Description = "N/A", ImageUrl = "images/dotnet_bot.svg" }
    };

    public class CardModel
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string ImageUrl { get; set; } = "";
    }
} *@

@page "/home"
@using MyHybridApp2.Services
@inject IAuthenticationService AuthService

<PageTitle>Home</PageTitle>

<div class="home-container">
    <div class="welcome-card">
        <h1>Welcome!</h1>
        <p>You have successfully logged in.</p>
        
        <button @onclick="HandleLogout" class="logout-button">
            Logout
        </button>
    </div>
</div>

@code {
    private void HandleLogout()
    {
        // TODO: Add logout logic here
        // Navigate back to login
        AuthService.NavigateToHome(); // You might want a LoginNavigateToLogin method
    }
}